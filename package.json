{
  "name": "lig",
  "private": true,
  "version": "0.0.0",
  "description": "Fintech platformları için white-label lig ve oyunlaştırma modülü",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "scripts": {
    "postinstall": "npm run build -w @lig/shared",
    "dev": "npm run shared:build && concurrently -n api,web,mock -c blue,magenta,yellow \"npm run dev -w @lig/api\" \"npm run dev -w @lig/web\" \"npm run dev -w @lig/mock-platform\"",
    "demo": "npm run shared:build && npm run build -w @lig/web && concurrently -n api,web,mock -c blue,magenta,yellow \"npm run dev -w @lig/api\" \"npm run start -w @lig/web\" \"npm run dev -w @lig/mock-platform\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "npm run db:generate -w @lig/api",
    "db:migrate": "npm run db:migrate -w @lig/api",
    "check": "npm run shared:build && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:seed": "npm run db:seed -w @lig/api",
    "db:seed:quick": "npm run db:seed:quick -w @lig/api",
    "secrets:new-key": "npm run secrets:new-key -w @lig/api --",
    "secrets:rotate": "npm run secrets:rotate -w @lig/api --",
    "admin:create": "npm run admin:create -w @lig/api --",
    "admin:reset-mfa": "npm run admin:reset-mfa -w @lig/api --",
    "audit:verify": "npm run audit:verify -w @lig/api",
    "shared:build": "npm run build -w @lig/shared",
    "test:int": "npm run shared:build && npm run test:int -w @lig/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
