{
  "name": "lig",
  "private": true,
  "version": "0.0.0",
  "description": "Fintech platformları için white-label lig ve oyunlaştırma modülü",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "npm run build -w @lig/shared",
    "dev": "concurrently -n api,web,mock -c blue,magenta,yellow \"npm run dev -w @lig/api\" \"npm run dev -w @lig/web\" \"npm run dev -w @lig/mock-platform\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "npm run db:generate -w @lig/api",
    "db:migrate": "npm run db:migrate -w @lig/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
