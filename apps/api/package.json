{
  "name": "@lig/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lig API: kurallar, emir motoru, ligler, sıralama, yönetim",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@lig/shared": "0.0.0",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/pg": "8.23.1",
    "chokidar": "5.0.0",
    "drizzle-kit": "0.31.10",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
