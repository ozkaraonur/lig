{
  "name": "@lig/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lig API: kurallar, emir motoru, ligler, sıralama, yönetim",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "tsx src/db/preflight.ts --redis && vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/preflight.ts && drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:quick": "tsx src/db/seed-quick-league.ts",
    "secrets:new-key": "tsx src/secrets/generate-key.ts",
    "secrets:rotate": "tsx src/secrets/rotate.ts",
    "admin:create": "tsx src/admin-auth/admin-cli.ts create",
    "admin:reset-mfa": "tsx src/admin-auth/admin-cli.ts reset-mfa",
    "audit:verify": "tsx src/audit/verify-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@lig/shared": "0.0.0",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/pg": "8.23.1",
    "chokidar": "5.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
