{
  "name": "@lig/mock-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Test ve demo için sahte müşteri platformu: oyuncu token'ı imzalar, fiyat yayınlar, webhook gönderir",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lig/shared": "0.0.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
