# Bu dosyayı .env olarak kopyala: copy .env.example .env  (macOS/Linux: cp .env.example .env)
# .env repoya girmez.

NODE_ENV=development

# Altyapı (docker compose ile gelir)
DATABASE_URL=postgres://lig:lig_dev_password@localhost:5432/lig
REDIS_URL=redis://localhost:6379

# Servis adresleri. 127.0.0.1: sadece bu bilgisayardan erişilir.
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000
MOCK_PLATFORM_HOST=127.0.0.1
MOCK_PLATFORM_PORT=4100
MOCK_PLATFORM_ISSUER=mock-platform
MOCK_PLATFORM_URL=http://127.0.0.1:4100
# İkinci sahte müşteri: Sahte Aracı Kurum (BIST hisseleri, açık tema)
MOCK_BROKER_PORT=4200
MOCK_BROKER_ISSUER=mock-broker
MOCK_BROKER_URL=http://127.0.0.1:4200
# Demo için gerçek kripto fiyatı (8. adım): "real" yapınca sahte platform halka açık borsa ucundan
# TL paritelerini okur. Varsayılan "simulated": dışarı istek gitmez.
MOCK_PLATFORM_PRICE_MODE=simulated
# MOCK_PLATFORM_REAL_PRICE_URL=https://api.btcturk.com/api/v2/ticker
# MOCK_PLATFORM_REAL_PRICE_REFRESH_MS=2000

# Oturum çerezinin gönderilebildiği tek web adresi (CORS)
WEB_ORIGIN=http://localhost:3000

# Arka plan işleri (fiyat alıcı). API'yi birden çok kopya çalıştırırken yalnızca birinde true.
WORKERS_ENABLED=true
PRICE_POLL_INTERVAL_MS=1000
RANKING_INTERVAL_MS=2000
OUTBOX_POLL_INTERVAL_MS=1000

# Sahte platformun gerçek işlem bildirimleri (webhook). Yalnızca yerel geliştirme değeri.
LIG_API_URL=http://127.0.0.1:4000
MOCK_PLATFORM_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
MOCK_BROKER_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# Veritabanındaki gizli değerleri (webhook anahtarı, MFA secret'ı) şifreleyen anahtar (K-015).
# Üret: npm run secrets:new-key   Üretimde zorunlu. Boş kalırsa herkesin bildiği geliştirme anahtarı kullanılır.
# SECRET_KEYS=k1:...

# Seed'in açtığı yerel yönetici hesabının parolası. Boşsa README'deki geliştirme parolası.
# SEED_ADMIN_PASSWORD=
